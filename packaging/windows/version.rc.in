#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SonyDeviceCenter_VERSION_MAJOR@,@SonyDeviceCenter_VERSION_MINOR@,@SonyDeviceCenter_VERSION_PATCH@,0
 PRODUCTVERSION @SonyDeviceCenter_VERSION_MAJOR@,@SonyDeviceCenter_VERSION_MINOR@,@SonyDeviceCenter_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@SONY_VERSION_TARGET@\0"
            VALUE "FileVersion", "@SonyDeviceCenter_VERSION@\0"
            VALUE "ProductName", "Sony Device Center\0"
            VALUE "ProductVersion", "@SonyDeviceCenter_VERSION@\0"
            VALUE "OriginalFilename", "@SONY_VERSION_TARGET@.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
